# Copy to backend/.env and edit. Never commit backend/.env.

# mock = simulated results, zero paid calls. live = real OpenAI + Google Places calls (billed).
APP_MODE=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
GOOGLE_MAPS_API_KEY=

# Must match the frontend dev server origin exactly (CORS).
FRONTEND_ORIGIN=http://localhost:5288

REQUEST_TIMEOUT_SECONDS=90
# Extra attempts after the first. Every attempt is budgeted and recorded.
MAX_RETRIES=1

MAX_UPLOAD_MB=10
MAX_IMAGES_PER_REQUEST=12
MIN_IMAGE_SIDE_PX=480
API_IMAGE_MAX_SIDE_PX=1600

# Per-assessment limits (in memory; reset when the backend restarts)
MAX_CALLS_PER_ASSESSMENT=12
MAX_TOKENS_PER_ASSESSMENT=250000
MAX_OUTPUT_TOKENS=4000
MAX_WEB_SEARCH_CALLS=6

# Project budget in THB (total, not monthly). Enter spend made outside this app in PRIOR_SPEND_THB.
PROJECT_BUDGET_THB=4000
PRIOR_SPEND_THB=0
# Assumed exchange rate. Set it to your card's actual rate.
USD_TO_THB=35

# Pricing assumptions in USD, checked 27 Oct 2026 against the provider pricing pages. Re-check before live use.
OPENAI_INPUT_USD_PER_1M=1.00
OPENAI_OUTPUT_USD_PER_1M=5.00
OPENAI_WEB_SEARCH_USD_PER_1K=10.00
ESTIMATED_TOKENS_PER_IMAGE=2500
ESTIMATED_SEARCH_CONTENT_TOKENS=8000
# true adds phone + website fields (Places Text Search Enterprise SKU); false uses the Pro SKU.
PLACES_INCLUDE_CONTACT_FIELDS=true
PLACES_PRO_USD_PER_1K=32.00
PLACES_ENTERPRISE_USD_PER_1K=35.00

# Local usage ledger (metadata only). Keep this file: it tracks the project budget across sessions.
USAGE_LEDGER_PATH=data/usage_ledger.jsonl
